# Pi-hole Environment Variables
# Copy this to .env and fill in your values

# Password for Pi-hole admin panel
PIHOLE_PASSWORD=your_password_here

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Monterrey

# DNS listening mode: ALL, single, or specific interface
PIHOLE_DNS_MODE=ALL

# Port mappings (change if conflicts with other services)
PORT_DNS_TCP=53
PORT_DNS_UDP=53
PORT_HTTP=80
PORT_HTTPS=443
